msgstr "Hava Durumu Eklentisi"

msgid "Weather Plugin Detailview"
msgstr "Hava Durumu Eklentisi Detay Görünümü"

msgid "Weather Plugin Overview"
msgstr "Hava Durumu Eklentisi Genel Bakış"

msgid "Weather Settings Actions"
msgstr "Hava Durumu Ayarları İşlemleri"

msgid "Weather city name"
msgstr "Hava durumu şehir adı"

msgid "Weather cityname (at least 3 letters):"
msgstr "Hava durumu şehir adı (en az 3 harf):"

msgid "Weather icon night switch"
msgstr "Hava durumu simgesi gece anahtarı"

msgid "Weather icon set"
msgstr "Hava durumu simge seti"

msgid "Weather service"
msgstr "Hava durumu servisi"

msgid "Weather API key v2.5"
msgstr "Hava Durumu API anahtarı v2.5"

msgid "Weather settings"
msgstr "Hava Durumu ayarları"

