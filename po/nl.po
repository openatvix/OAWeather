msgid ""
"Choose the icon set. You need to create an additional set here: /usr/share/"
"enigma2/WeatherIconSets/NAME."
msgstr ""
"Kies de iconset. U moet hier een aanvullende set aanmaken: /usr/share/"
"enigma2/WeatherIconSets/NAAM."

msgid ""
"Choose whether the 'night switch' should be activated or not. Some icons are "
"then displayed as night icons with moon."
msgstr ""
"Kies of de 'nachtmodus' geactiveerd moet worden of niet. Sommige iconen "
"worden dan weergegeven als nachticonen met maan."

msgid "Choose favorite"
msgstr "Favoriet kiezen"

#, python-format
msgid "City '%s' not found! Please try another wording."
msgstr ""
"De woonplaats '%s' werd niet gevonden! A.u.b. de omschrijving aanpassen."

