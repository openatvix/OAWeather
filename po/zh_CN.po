msgstr "当前天气"

msgid "Default"
msgstr "默认"

msgid "Defaults"
msgstr "默认"

msgid "Delete"
msgstr "删除"

msgid "Disabled"
msgstr "已禁用"

#, python-format
msgid ""
"Do you really want to delete favorite\n"
"'%s'?"
msgstr ""
"您确定要删除收藏\n"
"“%s”吗？"

