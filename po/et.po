msgstr "Fahrenheit"

msgid "Favorites have been successfully saved!"
msgstr "Lemmikud on edukalt salvestatud!"

msgid "Feels like"
msgstr "Tundub nagu"

msgid "Humidity"
msgstr "Niiskus"

msgid "MSN weather"
msgstr "MSN ilm"

msgid "Manage favorites"
msgstr "Halda lemmikuid"

msgid "Metric unit for wind speed"
msgstr "Tuule kiiruse meetermõõdustiku ühik"

msgid "Next favorite"
msgstr "Järgmine lemmik"

msgid "View details"
msgstr "Vaata üksikasju"

msgid "Day +/-"
msgstr "Päev +/-"

msgid "Settings"
msgstr "Seaded"

msgid "Manage your favorites"
msgstr "Hallake oma lemmikuid"

msgid "No data available for this period."
msgstr "Selle perioodi kohta pole andmeid saadaval."

