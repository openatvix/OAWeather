msgid ""
"Choose the icon set. You need to create an additional set here: /usr/share/"
"enigma2/WeatherIconSets/NAME."
msgstr ""
"Valige ikoonide komplekt. Peate looma täiendava komplekti siia: /usr/share/"
"enigma2/WeatherIconSets/NAME."

msgid ""
"Choose whether the 'night switch' should be activated or not. Some icons are "
"then displayed as night icons with moon."
msgstr ""
"Valige, kas 'öölüliti' tuleb aktiveerida või mitte. Mõned ikoonid "
"kuvatakse siis kuuga ööikoonidena."

msgid "Choose favorite"
msgstr "Vali lemmik"

#, python-format
msgid "City '%s' not found! Please try another wording."
msgstr "Linna '%s' ei leitud! Palun proovige teist sõnastust."

msgid "Current Weather"
msgstr "Praegune ilm"

msgid "Default"
msgstr "Vaikeväärtus"

msgid "Defaults"
msgstr "Vaikeväärtused"

msgid "Delete"
msgstr "Kustuta"

msgid "Disabled"
msgstr "Keelatud"

#, python-format
msgid ""
"Do you really want to delete favorite\n"
"'%s'?"
msgstr ""
"Kas soovite tõesti lemmiku kustutada\n"
"'%s'?"

msgid "Do you really want to exit without saving your modified favorite list?"
msgstr "Kas soovite tõesti väljuda muudetud lemmikute loendit salvestamata?"

